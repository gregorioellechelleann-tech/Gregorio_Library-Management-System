class Book:
    def __init__(self, book_id, title, author, available=True):
        self.book_id = book_id
        self.title = title
        self.author = author
        self.available = available


class LibraryService:
    def __init__(self):
        self.books = [
            Book(1, "Python Basics", "John Smith", True),
            Book(2, "Data Structures", "Alice Brown", False),
            Book(3, "Machine Learning", "David Lee", True)
        ]

    def view_books(self):

        # Check if list is empty
        if not self.books:
            print("No books found.")
            return

        print("\nBooks:")
        print("-" * 50)

        # Loop through books
        for book in self.books:

            # Check availability
            if book.available:
                status = "Available"
            else:
                status = "Borrowed"

            # Display output
            print(f"({book.book_id}) - {book.title} by {book.author} [{status}]")


# Main Program
library_service = LibraryService()

while True:
    print("\n===== Library Menu =====")
    print("1. Exit")
    print("5. View Books")

    choice = input("Enter your choice: ")

    if choice == "5":
        library_service.view_books()

    elif choice == "1":
        print("Program Ended.")
        break

    else:
        print("Invalid choice.")